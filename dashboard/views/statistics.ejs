<div class="metrics-grid mb-4">
  <div class="metric-card glass-card">
    <div class="metric-icon info"><i class="fa-solid fa-stopwatch"></i></div>
    <div class="metric-info">
      <span class="metric-label">Avg Response Time</span>
      <h3 class="metric-value" id="avgRespTime">-- mins</h3>
    </div>
  </div>

  <div class="metric-card glass-card">
    <div class="metric-icon warning"><i class="fa-solid fa-hourglass-end"></i></div>
    <div class="metric-info">
      <span class="metric-label">Avg Close Time</span>
      <h3 class="metric-value" id="avgCloseTime">-- mins</h3>
    </div>
  </div>

  <div class="metric-card glass-card">
    <div class="metric-icon success"><i class="fa-solid fa-circle-check"></i></div>
    <div class="metric-info">
      <span class="metric-label">Resolution Rate</span>
      <h3 class="metric-value" id="resolutionRate">--%</h3>
    </div>
  </div>
</div>

<div class="charts-grid">
  <!-- Tickets Per Day Line Chart -->
  <div class="chart-card glass-card">
    <div class="card-header">
      <h3><i class="fa-solid fa-chart-line"></i> Tickets Created Per Day</h3>
    </div>
    <div class="card-body chart-container">
      <canvas id="ticketsPerDayChart"></canvas>
    </div>
  </div>

  <!-- Ticket Type Distribution Pie Chart -->
  <div class="chart-card glass-card">
    <div class="card-header">
      <h3><i class="fa-solid fa-chart-pie"></i> Ticket Types Breakdown</h3>
    </div>
    <div class="card-body chart-container">
      <canvas id="ticketTypesChart"></canvas>
    </div>
  </div>

  <!-- Staff Activity Leaderboard Bar Chart -->
  <div class="chart-card glass-card full-width">
    <div class="card-header">
      <h3><i class="fa-solid fa-trophy"></i> Staff Ticket Activity Leaderboard</h3>
    </div>
    <div class="card-body chart-container">
      <canvas id="staffActivityChart"></canvas>
    </div>
  </div>
</div>

<script src="/js/charts.js"></script>
